<% layout("/layouts/boilerplate") %>

<h3 class="mt-3 mb-4">Meri Wishlist ❤️</h3>

<% if (wishlist.length === 0) { %>
  <p>Abhi koi listing save nahi ki. Kisi listing ka heart dabao!</p>
  <a href="/listings" class="btn btn-danger">Listings dekho</a>
<% } %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for (let listing of wishlist) { %>
    <div class="col mb-4 position-relative">
      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
        <div class="card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem; object-fit:cover;">
          <div class="card-body px-2 pt-2 pb-0">
            <p class="card-text mb-1"><strong><%= listing.title %></strong></p>
            <p class="card-text text-secondary">
              &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
            </p>
          </div>
        </div>
      </a>

      <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="heart-btn">
        <button type="submit" class="btn p-0 border-0 bg-transparent">
          <i class="fa-solid fa-heart text-danger fs-4"></i>
        </button>
      </form>
    </div>
  <% } %>
</div>