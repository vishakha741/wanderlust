<div class="tax-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after texes</label>
</div>
</div>
</div>

    <!-- Bootstrap Grid Row -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings) { %>
            <!-- Single Card Wrapper Column -->
            <div class="col mb-4 position-relative">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 1rem; overflow: hidden;">
                        <!-- Image with Fixed Height & Aspect Ratio -->
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 18rem; object-fit: cover;">
                        
                        <!-- Card Text Body -->
                        <div class="card-body px-2 pt-2 pb-0">
                            <p class="card-text mb-1">
                                <strong><%= listing.title %></strong>
                            </p>
                            <p class="card-text text-secondary">
                                &#8377; <span class="price" data-price="<%=listing.price %>"><%= listing.price.toLocaleString("en-IN") %></span>/ night
                                
                                <i class ="tax-info" style="display: none;">&nbsp; &nbsp; +18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>


            <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="heart-btn">
              <button type="submit" class="btn p-0 border-0 bg-transparent">
                <% if (wishlistIds.includes(listing._id.toString())) { %>
                  <i class="fa-solid fa-heart text-danger fs-4"></i>
                <% } else { %>
                  <i class="fa-regular fa-heart text-white fs-4"></i>
                <% } %>
              </button>
            </form>
        </div>
    <% } %>
    </div>
    
       <script>
  (function () {
    const toggle = document.getElementById("SwitchCheckDefault")
      || document.querySelector(".form-check-input");

    if (!toggle) {
      console.log("Toggle nahi mila");
      return;
    }

    toggle.addEventListener("change", function () {
      const on = toggle.checked;

      document.querySelectorAll(".tax-info").forEach(function (el) {
        el.style.display = on ? "inline" : "none";
      });

      document.querySelectorAll(".price").forEach(function (el) {
        const price = Number(el.dataset.price);
        const finalPrice = on ? Math.round(price * 1.18) : price;
        el.textContent = finalPrice.toLocaleString("en-IN");
      });
    });
  })();
</script>
    


