<% layout("/layouts/boilerplate") %>

    <!--<h3 class="mt-4">All Listings</h3>-->

<div id ="filters">
    <div class="filters">
       <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>

    <div class = "filters">
        <div><i class="fa-sharp fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>


<div class="filters">
    <div><i class="fa-solid fa-mountain-city"></i>
</div>
    <p>Tconic Cities</p>
</div>

<div class="filters">
    <div><i class="fa-solid fa-mountain"></i>
</div>
    <p>Mountain</p>
</div>
<div class="filters">
    <div><i class="fa-brands fa-fort-awesome"></i>
</div>
    <p>Castles</p>
</div>

<div class="filters">
    <div><i class="fa-sharp fa-solid fa-campground"></i>
</div>
    <p>Caming</p>
</div>

<div class="filters">
    <div><i class="fa-solid fa-tractor"></i>
</div>
    <p>Farms</p>
</div>
<div class="filters">
        <div><i class="fa-solid fa-landmark-dome"></i>
</div>

    <p>Domes</p>
</div>




<div class="tax-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after texes</label>
</div>
</div>
</div>

    <!-- Bootstrap Grid Row -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings) { %>
            <!-- Single Card Wrapper Column -->
            <div class="col mb-4">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: 1rem; overflow: hidden;">
                        <!-- Image with Fixed Height & Aspect Ratio -->
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 18rem; object-fit: cover;">
                        
                        <!-- Card Text Body -->
                        <div class="card-body px-2 pt-2 pb-0">
                            <p class="card-text mb-1">
                                <strong><%= listing.title %></strong>
                            </p>
                            <p class="card-text text-secondary">
                                &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                                
                                <i class ="tax-info">&nbsp; &nbsp; +18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
    
        <script>
  let taxSwitch = document.getElementById("SwitchCheckDefault");
  
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    
    for (let info of taxInfo) {
      if (info.style.display === "none" || info.style.display === "") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
    


