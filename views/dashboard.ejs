<%layout("/layouts/boilerplate")%>
<div class="container mt-4">
  <h3>My Dashboard</h3>
  <p>Welcome, <%= currUser.username %></p>

  <h5 class="mt-4">My Listings (<%= myListings.length %>)</h5>
  <% if (myListings.length === 0) { %>
    <p class="text-secondary">Tumne abhi tak koi listing nahi banayi.</p>
  <% } %>
  <div class="row row-cols-1 row-cols-md-3">
    <% for (let l of myListings) { %>
      <div class="col mb-3">
        <a href="/listings/<%= l._id %>" class="text-decoration-none text-dark">
          <div class="card h-100">
            <img src="<%= l.image.url %>" class="card-img-top" style="height:12rem; object-fit:cover;" alt="listing">
            <div class="card-body">
              <p class="card-text mb-0"><strong><%= l.title %></strong></p>
              <small class="text-secondary"><%= l.category %></small>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
  <h5 class="mt-4">My Bookings (<%= myBookings.length %>)</h5>
<% if (myBookings.length === 0) { %>
  <p class="text-secondary">Abhi tak koi booking nahi hai.</p>
<% } %>
<% for (let b of myBookings) { %>
  <div class="card mb-2">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <% if (b.listing) { %>
          <a href="/listings/<%= b.listing._id %>" class="text-dark fw-bold text-decoration-none"><%= b.listing.title %></a>
        <% } else { %>
          <span class="text-secondary">Listing hata di gayi</span>
        <% } %>
        <div class="small text-secondary">
          <%= new Date(b.checkIn).toLocaleDateString("en-IN") %> to <%= new Date(b.checkOut).toLocaleDateString("en-IN") %>
          &middot; &#8377; <%= b.totalPrice %>
        </div>
      </div>
      <span class="badge <%= b.status === 'confirmed' ? 'bg-success' : 'bg-secondary' %>"><%= b.status %></span>
    </div>
<h5 class="mt-4">My Wishlist (<%= myWishlist.length %>)</h5>
<% if (myWishlist.length === 0) { %>
  <p class="text-secondary">Wishlist abhi khali hai.</p>
<% } %>
<div class="row row-cols-1 row-cols-md-3">
  <% for (let w of myWishlist) { %>
    <div class="col mb-3">
      <a href="/listings/<%= w._id %>" class="text-decoration-none text-dark">
        <div class="card h-100">
          <img src="<%= w.image.url %>" class="card-img-top" style="height:12rem; object-fit:cover;" alt="listing">
          <div class="card-body">
            <p class="card-text mb-0"><strong><%= w.title %></strong></p>
            <small class="text-secondary"><%= w.location %>, <%= w.country %></small>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>







  </div>
<% } %>










</div>